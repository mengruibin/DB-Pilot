# ============================================================
# DB-Pilot 后端配置模板
# 复制此文件为 .env 并填入实际值。
# .env 必须在 .gitignore 中——切勿提交真实密钥到仓库。
# ============================================================

# ==================== LLM 提供方 ====================
# 必填：LLM API Key（默认 Anthropic。如用 OpenAI 请填对应 key）
LLM_API_KEY=sk-ant-api03-your-key-here
# 必填：复杂任务模型（NL2SQL、诊断、故障排查）
LLM_MODEL=claude-opus-4-8
# 可选：LLM 提供方切换，设为 "openai" 使用 OpenAI 兼容接口（默认：anthropic）
LLM_PROVIDER=anthropic
# 可选：自定义 LLM API URL。留空使用 provider 默认地址。
# 使用阿里云百炼等 OpenAI 兼容服务时，设置 LLM_PROVIDER=openai 并填入此地址。
# 示例：LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_API_URL=
# 可选：是否启用深度推理（true/false）
ENABLE_REASONING=

# ==================== 内部数据库 ====================
# 必填：内部数据库连接串（支持 mysql+aiomysql 或 sqlite+aiosqlite）
# MySQL 示例：mysql+aiomysql://root:password@127.0.0.1:3306/db_pilot
# SQLite 示例：sqlite+aiosqlite:///./data/db_pilot.db
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/db_pilot

# ==================== Checkpointer（PostgreSQL） ====================
# 必填：LangGraph AsyncPostgresSaver 连接串（psycopg 格式）
# 示例：postgresql://postgres:password@127.0.0.1:5432/db_pilot_checkpoint
# 需先创建数据库：CREATE DATABASE db_pilot_checkpoint;
# checkpoint 在用户删除会话时联动删除（adelete_thread），无自动 TTL
CHECKPOINT_DB_URL=

# ==================== 服务端 ====================
# 可选：服务监听地址（默认：127.0.0.1）
SERVER_HOST=127.0.0.1
# 可选：服务监听端口（默认：8000）
SERVER_PORT=8000
# 可选：允许的 CORS 域名（逗号分隔，默认：http://localhost:5173）
CORS_ORIGINS=http://localhost:5173

# ==================== 安全 ====================
# 可选：会话空闲超时分钟数（默认：30，PRD §8.2 要求 30 分钟自动清理）
SESSION_IDLE_TIMEOUT_MINUTES=30

# ==================== 认证 ====================
# 必填：JWT 签名密钥（至少 32 字符），用于签发用户登录令牌
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# 可选：JWT 过期时间（分钟，默认：1440 = 24 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 日志与可观测性 ====================
# 可选：日志级别，DEBUG 可见 SQL 查询（默认：DEBUG）
LOG_LEVEL=DEBUG
# 可选：日志输出格式，json=JSON行（生产）/ text=彩色控制台（开发）
LOG_FORMAT=text
# 可选：日志文件输出目录（自动创建，默认：logs）
LOG_DIR=logs
# 可选：日志文件路径，留空则使用 LOG_DIR 按日期自动生成
LOG_FILE=
# 可选：日志保留天数（默认：30）
LOG_BACKUP_DAYS=30
# 可选：是否启用链路追踪（默认：True）
LOG_TRACE_ENABLED=True

# ==================== 上下文压缩 ====================
# 可选：是否启用上下文压缩（默认：True，关闭后全量发送历史）
AGENT_CONTEXT_COMPRESS_ENABLED=True
# 可选：懒触发阈值，LLM 输入估算 token 超过该值才启动压缩（默认：60000）
AGENT_COMPACT_TRIGGER_TOKENS=60000
# 可选：近 K 轮窗口逐字保留（默认：5，0=只保留当前轮全部旧轮进摘要）
AGENT_KEEP_RECENT_TURNS=5
# 可选：闲置衰减，新轮距上一轮超过该分钟数时窗口 K 归 0（默认：60）
AGENT_IDLE_DECAY_MINUTES=60
# 可选：摘要最多保留最近 N 轮（默认：20）
AGENT_DIGEST_MAX_TURNS=20
# 可选：摘要中每轮用户问题最大字符数（默认：300，语义锚点，正常问题远小于此）
AGENT_DIGEST_MAX_Q_CHARS=300
# 可选：摘要中每轮助手结论最大字符数（默认：200，核心载荷）
AGENT_DIGEST_MAX_CONCLUSION_CHARS=200
# 可选：摘要中单个工具参数最大字符数（默认：300，实测 SQL avg 115 / max 244，正常不截）
AGENT_DIGEST_MAX_ARG_CHARS=300
# 可选：token 估算启发式，每字符折算 token 数（默认：3，小值=估高=提前触发）
AGENT_ESTIMATE_CHARS_PER_TOKEN=3
# 可选：EXPLAIN 类结果截断上限字符数（默认：8000）
EXPLAIN_MAX_CHARS=8000

# ==================== LLM 并发限流 ====================
# 可选：全局 LLM 调用并发上限，同一时刻最多允许的 LLM 请求数（进程级，默认：5）。
# 单进程部署下即全局硬上限，防止并发请求打爆 provider 配额触发 429 限流。
AGENT_MAX_CONCURRENT_LLM=5
# 可选：LLM 并发饱和时的排队等待超时（秒），超时返回「AI 服务繁忙」提示（默认：30）
AGENT_LLM_WAIT_TIMEOUT_SECONDS=30

# ─── csv结果导出 ───
# 可选：导出结果最大行数（默认：100000）
EXPORT_MAX_ROWS=100000   
# 可选：导出结果批量写入数据库大小（默认：2000）
EXPORT_BATCH_SIZE=2000
